# Site (used for SEO, Open Graph, sitemap, canonical URLs)
NEXT_PUBLIC_SITE_URL=https://sachinchoudhary.dev

# EmailJS — https://dashboard.emailjs.com
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# AI project estimator (Cloudflare Worker in /worker). Leave empty to hide the section.
# Local dev with `cd worker && npm run dev` + Turnstile test sitekey:
NEXT_PUBLIC_ESTIMATOR_URL=http://127.0.0.1:8787
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
